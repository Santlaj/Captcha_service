# ==========================================
# CAPTCHA-as-a-Service Environment Template
# ==========================================
# Safe template for local development.
# Copy this file to .env before starting services:
# cp .env.example .env

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=captcha_service
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis Configuration
# Provide REDIS_URL or use REDIS_HOST + REDIS_PORT + REDIS_PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Challenge Storage & Expiration (Sensible bounds enforced)
# CAPTCHA_TTL_SECONDS: 10 to 3600 (default: 300)
# MAX_VERIFICATION_ATTEMPTS: 1 to 20 (default: 5)
CAPTCHA_TTL_SECONDS=300
MAX_VERIFICATION_ATTEMPTS=5

# JWT Verification Token Configuration
# In production, provide a cryptographically random secret with at least 32 characters.
# JWT_EXPIRES_IN_SECONDS: 10 to 86400 (default: 300)
JWT_SECRET=development_only_jwt_secret_key_change_in_production_min32
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_SECONDS=300

# Server-to-Server Site Verification Secret Key
# Private key used by external application backends to call POST /api/v1/siteverify.
# Defaults to JWT_SECRET if left unset.
SITEVERIFY_SECRET_KEY=development_only_jwt_secret_key_change_in_production_min32

# Rate Limiting (Requests per minute per client IP, bounds: 1 to 10000)
RATE_LIMIT_CHALLENGE_PER_MINUTE=60
RATE_LIMIT_SOLUTION_PER_MINUTE=30

# Reverse Proxy / Client IP Handling
# Options:
# - 'false': Direct internet-facing Node server without proxy (default, ignores X-Forwarded-For)
# - '1': 1 hop behind reverse proxy (e.g. AWS ALB, Cloudflare, single Nginx)
# - 'true': Trust all hops (use only in trusted private network VPC)
# - 'loopback, 10.0.0.0/8': Comma-separated trusted subnets/IPs
TRUST_PROXY=false

# Development Controls (Set to false to disable GET /api/v1/challenge/preview)
# Strictly defaults to false in production for security
ENABLE_PREVIEW_ENDPOINT=true

# CORS Allowed Origins (Comma-separated list of allowed origins)
# In development: http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5180
# In production: Provide your exact frontend web domains (e.g. https://app.example.com,https://dashboard.example.com)
# Note: Wildcard '*' disables credentials automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5180


